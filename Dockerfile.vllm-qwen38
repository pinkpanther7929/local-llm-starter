# Keep the Qwen3.8 runtime isolated from Dockerfile.vllm, which remains the
# known-good Qwen3-14B-AWQ / CUDA 12.9 stack.
# vLLM 0.27.1 includes Qwen3.8 support and its matching CUDA 13.0 runtime.
FROM vllm/vllm-openai:v0.27.1

# Qwen3.8's Gated DeltaNet path makes Triton compile a small CUDA helper at
# startup. Use the base distribution's supported compiler rather than
# assuming the image carries a particular GCC major version.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/vllm-entrypoint.sh /usr/local/bin/vllm-entrypoint
RUN chmod 0755 /usr/local/bin/vllm-entrypoint

ENTRYPOINT ["/usr/local/bin/vllm-entrypoint"]
