# Text-only alternative to 64K CPU offload: 56 * 1024 tokens total.
COMPOSE_PROFILES=vllm

# Priority scheduler (host port 8000) in front of the backend. Keep equal to LOCAL_MAX_NUM_SEQS (1 on a 24GB card); a larger value moves the queue into vLLM.
SCHED_UPSTREAM=http://vllm:8000
SCHED_CONCURRENCY=1

VLLM_DOCKERFILE=Dockerfile.vllm-qwen38
CC=/usr/bin/gcc
CXX=/usr/bin/g++
SERVED_MODEL_NAME=qwen3.8-27b

MODEL_ID=cyankiwi/Qwen3.8-27B-AWQ-INT4
MAX_MODEL_LEN=57344
# Keep other scheduling settings unchanged for comparison with the 64K run.
GPU_MEMORY_UTILIZATION=0.98
LOCAL_MAX_NUM_SEQS=1
LOCAL_MAX_BATCHED_TOKENS=512
# Avoid per-forward host weight transfers; reject image/video inputs.
LOCAL_CPU_OFFLOAD_GB=0
LOCAL_LANGUAGE_MODEL_ONLY=1
KV_CACHE_DTYPE=fp8
VLLM_ENFORCE_EAGER=1

ATTENTION_BACKEND=TRITON_ATTN
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=0
HF_OVERRIDES={}

REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml

OPEN_WEBUI_PORT=3000

HF_TOKEN=

FILE_SEARCH_ENABLED=false
FILE_SEARCH_POLICY=keyword
FILE_SEARCH_HOST_PATH=./knowledge
FILE_SEARCH_CONTAINER_PATH=/knowledge
P4_SYNC_ENABLED=false
P4_SYNC_HOST_DIR=./runtime/p4-sync
P4_SYNC_TIMEOUT_SECONDS=600
