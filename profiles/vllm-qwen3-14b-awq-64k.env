# Experimental 64K vLLM profile for Qwen3-14B-AWQ.
# This exceeds the model config's derived 40K context and depends on YaRN.
COMPOSE_PROFILES=vllm

UPSTREAM_BASE_URL=http://vllm:8000/v1
SERVED_MODEL_NAME=qwen-14b

MODEL_ID=Qwen/Qwen3-14B-AWQ
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.95
KV_CACHE_DTYPE=fp8
# fp8 KV cache leaves only FLASHINFER and TRITON_ATTN. FlashInfer kernels have
# already taken this card off the PCIe bus once, so pin Triton.
VLLM_ATTENTION_BACKEND=TRITON_ATTN
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
HF_OVERRIDES={"rope_scaling":{"rope_type":"yarn","factor":2.0,"original_max_position_embeddings":32768}}

VLLM_PORT=8000
OPEN_WEBUI_PORT=3000
AGENT_GATEWAY_PORT=8010
SEARXNG_PORT=8081
SEARXNG_PUBLIC_URL=http://localhost:8081/

HF_TOKEN=
