# Strata Qwen3.8-Flash-Next (125B-A6B MoE) IQ3_S 128K profile for RTX 4090 + 128GB RAM
COMPOSE_PROFILES=strata

UPSTREAM_BASE_URL=http://strata:8000/v1
SERVED_MODEL_NAME=qwen3.8-flash-next-iq3_s

STRATA_MODEL=iq3_s
STRATA_CONTEXT=128k
STRATA_VISION=gpu
STRATA_TUNE=skip
STRATA_PORT=8000
STRATA_ALLOWED_HOSTS=strata,strata:8000,localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

OPEN_WEBUI_PORT=3000
AGENT_GATEWAY_PORT=8010
SEARXNG_PORT=8081
SEARXNG_PUBLIC_URL=http://localhost:8081/

FILE_SEARCH_ENABLED=false
FILE_SEARCH_POLICY=keyword
FILE_SEARCH_HOST_PATH=./knowledge
FILE_SEARCH_CONTAINER_PATH=/knowledge
P4_SYNC_ENABLED=false
P4_SYNC_HOST_DIR=./runtime/p4-sync
P4_SYNC_TIMEOUT_SECONDS=600

