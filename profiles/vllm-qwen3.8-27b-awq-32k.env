# First-run profile: Qwen3.8-27B W4A16 AWQ on one RTX 4090 24GB.
# This model's 262K context is native; no YaRN override is used.
COMPOSE_PROFILES=vllm

VLLM_DOCKERFILE=Dockerfile.vllm-qwen38
# The vLLM 0.27.1 base supplies its distro compiler, not gcc-14.
CC=/usr/bin/gcc
CXX=/usr/bin/g++
UPSTREAM_BASE_URL=http://vllm:8000/v1
SERVED_MODEL_NAME=qwen3.8-27b

# Community W4A16 checkpoint. The official BF16/FP8 weights exceed 24GB.
MODEL_ID=cyankiwi/Qwen3.8-27B-AWQ-INT4
MAX_MODEL_LEN=32768
# Measured on RTX 4090: eager mode leaves 0.07GiB KV at 0.90, while 32K
# requires 1.15GiB. Reserve 98% for this single-process experimental profile.
GPU_MEMORY_UTILIZATION=0.98
KV_CACHE_DTYPE=fp8
# CUDAGraph warmup needs an extra ~0.8GiB beyond this 19GiB W4A16 model.
# Eager mode frees that transient allocation on a 24GB RTX 4090.
VLLM_ENFORCE_EAGER=1

# Do not use FlashInfer on this Ada card while the PCIe incident is monitored.
ATTENTION_BACKEND=TRITON_ATTN
VLLM_USE_FLASHINFER_SAMPLER=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=0
HF_OVERRIDES={}

# Qwen3.8 parser names differ from the previous Qwen3 profile.
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml

VLLM_PORT=8000
OPEN_WEBUI_PORT=3000
AGENT_GATEWAY_PORT=8010
SEARXNG_PORT=8081
SEARXNG_PUBLIC_URL=http://localhost:8081/

HF_TOKEN=
