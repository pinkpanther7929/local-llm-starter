# Copy to /etc/local-llm-p4-sync.env, chmod 600, then fill actual host values.
# No password here: use an existing ticket from p4 login under service user.
P4_BIN=/usr/local/bin/p4
P4PORT=REPLACE_WITH_P4_SERVER
P4USER=REPLACE_WITH_P4_USER
P4CLIENT=REPLACE_WITH_P4_CLIENT
P4TICKETS=/root/.p4tickets
P4TRUST=/root/.p4trust
P4_SYNC_WORKSPACE=/opt/TS_BuildMachine-10.6.6.56_main
P4_SYNC_SOCKET=/opt/local-llm-starter/runtime/p4-sync/sync.sock
