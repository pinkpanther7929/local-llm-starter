# vLLM profile for a single RTX 4090 24GB class machine.
COMPOSE_PROFILES=vllm

# Priority scheduler (host port 8000) in front of the backend. Keep at or below vLLM max-num-seqs (not set by this profile); tune against measured latency.
SCHED_UPSTREAM=http://vllm:8000
SCHED_CONCURRENCY=4

SERVED_MODEL_NAME=qwen-14b

MODEL_ID=Qwen/Qwen3-14B-AWQ
MAX_MODEL_LEN=12288
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=auto
VLLM_ALLOW_LONG_MAX_MODEL_LEN=0
HF_OVERRIDES={}

OPEN_WEBUI_PORT=3000

HF_TOKEN=
