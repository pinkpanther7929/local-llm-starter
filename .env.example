# Copy to .env and adjust for your machine.

# Compose profile:
# - vllm: docker compose --profile vllm up -d --build
# - ollama: docker compose --profile ollama up -d
COMPOSE_PROFILES=vllm

# Host ports. Only these two are published: the API (agent-gateway) and the Open WebUI.
# The scheduler, backends (strata/vllm/ollama), tool-service and SearXNG stay on the Docker network.
OPEN_WEBUI_PORT=3000
API_PORT=8000

# Priority scheduler: every model call goes through it, whichever profile is active.
# SCHED_UPSTREAM is the backend, SCHED_CONCURRENCY its slot count (vLLM: --max-num-seqs).
#   strata: http://strata:8000   vllm: http://vllm:8000   ollama: http://ollama:11434
SCHED_UPSTREAM=http://vllm:8000
SCHED_CONCURRENCY=4
SCHED_AGING_SEC=120
SCHED_DEFAULT_PRIORITY=P2
# Default priority by source IP when no X-LLM-Priority header, e.g. 10.6.5.155=P2
SCHED_IP_PRIORITY=

# Open WebUI talks to the local gateway with this key.
OPENAI_API_KEY=sk-local

# agent-gateway always reaches the model through llm-scheduler (fixed in docker-compose.yml).
SERVED_MODEL_NAME=qwen-14b

# Hugging Face token is required when model access is gated or not cached locally.
HF_TOKEN=

# vLLM profile.
MODEL_ID=Qwen/Qwen3-14B-AWQ
MAX_MODEL_LEN=12288
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=auto
VLLM_ALLOW_LONG_MAX_MODEL_LEN=0
HF_OVERRIDES={}
# Keep 0 on RTX 4090 class cards. 1 re-enables the FlashInfer sampler.
VLLM_USE_FLASHINFER_SAMPLER=0
# Passed as --attention-backend to keep FlashInfer out of the attention path
# too. KV_CACHE_DTYPE=fp8 rules FLASH_ATTN out and leaves only FLASHINFER and
# TRITON_ATTN, so fp8 profiles must set TRITON_ATTN.
ATTENTION_BACKEND=FLASH_ATTN

# Ollama profile. Set SCHED_UPSTREAM=http://ollama:11434 and SERVED_MODEL_NAME
# to an installed Ollama model, for example qwen3:8b.
OLLAMA_KEEP_ALIVE=24h

# SearXNG serves web search on the internal Docker network only (no host port).

# Agent gateway tuning.
WEB_SEARCH_POLICY=keyword
FETCH_URL_ENABLED=true
FILE_SEARCH_ENABLED=false
FILE_SEARCH_POLICY=keyword
FILE_SEARCH_HOST_PATH=./knowledge
FILE_SEARCH_CONTAINER_PATH=/knowledge
MAX_TOOL_ROUNDS=4
UPSTREAM_RETRIES=6
UPSTREAM_RETRY_DELAY_SECONDS=2

# Smoke test options used by scripts/smoke-test.sh.
SMOKE_HOST=localhost
SMOKE_TIMEOUT=20
SMOKE_CHAT_TIMEOUT=90
SMOKE_SKIP_CHAT=false
