# Ollama profile. Pull the model once after first startup:
# docker exec -it ollama ollama pull qwen3:8b
COMPOSE_PROFILES=ollama

# Priority scheduler (host port 8000) in front of the backend. Ollama parallelism is left at its default; raise together with OLLAMA_NUM_PARALLEL.
SCHED_UPSTREAM=http://ollama:11434
SCHED_CONCURRENCY=1

SERVED_MODEL_NAME=qwen3:8b

OLLAMA_KEEP_ALIVE=24h
OPEN_WEBUI_PORT=3000
